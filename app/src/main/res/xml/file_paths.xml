<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Temp photos captured for file uploads live in cacheDir/camera. -->
    <cache-path
        name="camera_photos"
        path="camera/" />
    <!-- Generated story cards shared through Android's chooser live in cacheDir/share. -->
    <cache-path
        name="shared_images"
        path="share/" />
</paths>
